# Brightpath vendor-core mock (external SIS) image
FROM eclipse-temurin:21-jdk AS builder
WORKDIR /workspace
COPY . .
RUN ./gradlew :core-mock:shadowJar --no-daemon -q

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=builder /workspace/core-mock/build/libs/core-mock-1.0.0-all.jar /app/app.jar
EXPOSE 8082
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
