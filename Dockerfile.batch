# Brightpath batch (scheduled jobs) image
FROM eclipse-temurin:21-jdk AS builder
WORKDIR /workspace
COPY . .
RUN ./gradlew :batch:shadowJar --no-daemon -q

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=builder /workspace/batch/build/libs/batch-1.0.0-all.jar /app/app.jar
EXPOSE 8083
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
