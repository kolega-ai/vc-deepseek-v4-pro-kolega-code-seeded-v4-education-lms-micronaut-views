# Brightpath decision (authorization tier) image
FROM eclipse-temurin:21-jdk AS builder
WORKDIR /workspace
COPY . .
RUN ./gradlew :decision:shadowJar --no-daemon -q

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=builder /workspace/decision/build/libs/decision-1.0.0-all.jar /app/app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
